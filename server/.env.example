# Copy to .env and fill in. Never commit .env.
# Supabase: Project -> Connect -> "Transaction pooler" URI (port 6543, IPv4-friendly, best for Vercel).
# Leave unset to use a local SQLite file instead.
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Dashboard login (required on Vercel; set the same value there as ADMIN_KEY).
# ADMIN_KEY=<long random string>

# Optional: 'sender' (default, registered number is enough) or 'strict' (also needs per-message code).
# VERIFY_MODE=sender
