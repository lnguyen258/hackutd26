# Copy to .env and fill in. Never commit .env.
# SpacetimeDB owner token (the identity that published the module). Print yours with:
#   spacetime login show --token
SPACETIMEDB_TOKEN=<owner token>
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=veritext-registry

# Dashboard login (required on Vercel; set the same value there as ADMIN_KEY).
# ADMIN_KEY=<long random string>

# Optional: 'sender' (default, registered number is enough) or 'strict' (also needs per-message code).
# VERIFY_MODE=sender
#
# With no SPACETIMEDB_TOKEN the server falls back to an in-memory store (offline dev only).
